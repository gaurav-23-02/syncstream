# Spotify Developer App Credentials
# Create your app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/auth/spotify/callback

# Google Cloud Project Credentials (YouTube Data API v3)
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# App Configuration
DEMO_MODE=false
FRONTEND_URL=http://localhost:5173
PORT=8080
